# Place this file as  htdocs/laravel/.htaccess  on InfinityFree.
# It blocks all direct web access to your application source/.env, so only
# the front controller in htdocs/index.php can reach the framework.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Belt-and-braces: never serve dotfiles (e.g. .env) even if the rules above
# are ignored by the host.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
