# =============================================================================
# Production .env for InfinityFree.
# Copy this to  deploy/infinityfree/.env.production  (already gitignored),
# fill in the DB_* values from your InfinityFree control panel, then the build
# script ships it to  htdocs/laravel/.env .
# =============================================================================

APP_NAME=SRMSS
APP_ENV=production
# Generate this into your gitignored .env.production (see DEPLOY.md Step 3) :
# never commit a real key:   php artisan key:generate --show
APP_KEY=
APP_DEBUG=false

# Set this to your live URL once you know it (InfinityFree gives you a free
# subdomain, e.g. https://srmss.infinityfreeapp.com). Use https:// after you
# enable the free SSL certificate in the panel.
APP_URL=https://YOUR-SUBDOMAIN.infinityfreeapp.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Database : copy these from InfinityFree → MySQL Databases.
# The DB name and username are auto-generated and look like  epiz_12345678_srmss .
# DB_HOST is the "MySQL hostname" shown in the panel (e.g. sqlXXX.infinityfree.com),
# NOT localhost : InfinityFree runs MySQL on a separate server.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=epiz_XXXXXXXX_srmss
DB_USERNAME=epiz_XXXXXXXX
DB_PASSWORD=YOUR_DB_PASSWORD

# -----------------------------------------------------------------------------
# Use file/sync drivers on shared hosting: no queue worker exists and it keeps
# the per-hour MySQL query count down. Your app TABLES still live in MySQL.
# -----------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail just writes to the log file (no SMTP needed for the demo). Swap in real
# SMTP credentials later if you need to actually send email.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional : route map uses free Leaflet + OpenStreetMap when this is blank.
GOOGLE_MAPS_API_KEY=

VITE_APP_NAME="${APP_NAME}"
